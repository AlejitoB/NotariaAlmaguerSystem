@page "/clientes"
@rendermode InteractiveServer
@inject ClienteService Svc
@inject Session Session
@inject NavigationManager Nav



<PageTitle>Clientes</PageTitle>
<h1>👤 Clientes</h1>

@if (msg != null)
{
    <div class="alert alert-info alert-dismissible fade show">@msg
        <button class="btn-close" @onclick="()=>msg=null"></button>
    </div>
}

<button class="btn btn-primary mb-3" @onclick="Nuevo">+ Nuevo Cliente</button>

@if (mostrar)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-bold">@(editando?"Editar":"Nuevo") Cliente</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Cédula *</label>
                    <input class="form-control" @bind="form.Cedula" placeholder="12345678" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nombre completo *</label>
                    <input class="form-control" @bind="form.Nombre" placeholder="Nombre" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" @bind="form.Telefono" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Dirección</label>
                    <input class="form-control" @bind="form.Direccion" />
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success me-2" @onclick="Guardar">💾 Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (lista == null)
{
    <p><em>Cargando...</em></p>
}
else if (!lista.Any())
{
    <p class="text-muted">No hay clientes registrados.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr><th>#</th><th>Cédula</th><th>Nombre</th><th>Teléfono</th><th>Dirección</th><th>Registro</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var c in lista)
            {
                <tr>
                    <td>@c.IdCliente</td>
                    <td>@c.Cedula</td>
                    <td>@c.Nombre</td>
                    <td>@(c.Telefono ?? "-")</td>
                    <td>@(c.Direccion ?? "-")</td>
                    <td>@(c.FechaRegistro ?? "-")</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="()=>Editar(c)">✏️</button>
                        <button class="btn btn-sm btn-danger" @onclick="()=>Eliminar(c.IdCliente)">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<NotariaAlmaguer.Web.Models.Cliente>? lista;
    NotariaAlmaguer.Web.Models.Cliente form = new();
    bool mostrar, editando;
    string? msg;

    protected override async Task OnInitializedAsync() => await Cargar();
    async Task Cargar() => lista = await Svc.GetAllAsync();
    void Nuevo() { form = new(); editando = false; mostrar = true; }
    void Editar(NotariaAlmaguer.Web.Models.Cliente c) { form = new() { IdCliente=c.IdCliente, Cedula=c.Cedula, Nombre=c.Nombre, Telefono=c.Telefono, Direccion=c.Direccion }; editando=true; mostrar=true; }
    void Cancelar() { mostrar=false; form=new(); }

    async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(form.Cedula) || string.IsNullOrWhiteSpace(form.Nombre))
        { msg="⚠️ Cédula y nombre son obligatorios."; return; }
        if (editando) await Svc.UpdateAsync(form);
        else await Svc.CreateAsync(form);
        msg = editando ? "✅ Cliente actualizado." : "✅ Cliente creado.";
        mostrar=false; await Cargar();
    }

    async Task Eliminar(int id)
    { await Svc.DeleteAsync(id); msg="🗑️ Cliente eliminado."; await Cargar(); }

    protected override void OnInitialized()
{
    if (!Session.Activa)
    {
        Nav.NavigateTo("/login");
    }
}
}
