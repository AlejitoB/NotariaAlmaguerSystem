@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@page "/documentos"
@rendermode InteractiveServer

@inject DocumentoService DocSvc
@inject ClienteService ClienteSvc
@inject NotarioService NotarioSvc
@inject IJSRuntime JS
@inject Session Session
@inject NavigationManager Nav

<PageTitle>Documentos</PageTitle>

<h1>📄 Documentos Notariales</h1>

@if (msg != null)
{
    <div class="alert alert-info alert-dismissible fade show">
        @msg
        <button class="btn-close" @onclick="()=>msg=null"></button>
    </div>
}

<!-- Búsqueda -->
<div class="input-group mb-3" style="max-width:400px">

    <input class="form-control"
           @bind="busqueda"
           placeholder="🔍 Buscar por N° documento..." />

    <button class="btn btn-outline-secondary"
            @onclick="Buscar">
        Buscar
    </button>

    <button class="btn btn-outline-danger"
            @onclick="LimpiarBusqueda">
        ✕
    </button>

</div>

<button class="btn btn-primary mb-3"
        @onclick="Nuevo">
    + Nuevo Documento
</button>

@if (mostrar)
{
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white fw-bold">
            @(editando ? "Editar" : "Nuevo") Documento
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">N° Documento *</label>

                    <input class="form-control"
                           @bind="form.NumeroDocumento"
                           placeholder="DOC-2025-001" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Tipo *</label>

                    <select class="form-select"
                            @bind="form.TipoDocumento">

                        <option value="">-- Seleccione --</option>

                        <option>Escritura Pública</option>
                        <option>Poder Notarial</option>
                        <option>Declaración Juramentada</option>
                        <option>Testamento</option>
                        <option>Autenticación</option>
                        <option>Otro</option>

                    </select>
                </div>

                <div class="col-md-4">

                    <label class="form-label">Cliente *</label>

                    <select class="form-select"
                            @bind="form.IdCliente">

                        <option value="0">-- Seleccione --</option>

                        @foreach (var c in clientes ?? [])
                        {
                            <option value="@c.IdCliente">
                                @c.Nombre
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-4">

                    <label class="form-label">Notario *</label>

                    <select class="form-select"
                            @bind="form.IdNotario">

                        <option value="0">-- Seleccione --</option>

                        @foreach (var n in notarios ?? [])
                        {
                            <option value="@n.IdNotario">
                                @n.Nombre
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-5">

                    <label class="form-label">Descripción</label>

                    <input class="form-control"
                           @bind="form.Descripcion" />

                </div>

                <div class="col-md-4">

                    <label class="form-label">Archivo PDF</label>

                    <InputFile class="form-control"
                               accept=".pdf"
                               OnChange="CargarPdf" />

                    @if (pdfBytes != null)
                    {
                        <small class="text-success">
                            ✅ PDF cargado (@(pdfBytes.Length / 1024) KB)
                        </small>
                    }

                </div>

            </div>

            <div class="mt-3">

                <button class="btn btn-success me-2"
                        @onclick="Guardar">
                    💾 Guardar
                </button>

                <button class="btn btn-secondary"
                        @onclick="Cancelar">
                    Cancelar
                </button>

            </div>

        </div>

    </div>
}

@if (lista == null)
{
    <p><em>Cargando...</em></p>
}
else if (!lista.Any())
{
    <p class="text-muted">
        No hay documentos registrados.
    </p>
}
else
{
    <table class="table table-striped table-hover">

        <thead class="table-dark">

            <tr>
                <th>#</th>
                <th>N° Doc.</th>
                <th>Tipo</th>
                <th>Cliente</th>
                <th>Notario</th>
                <th>Fecha</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var d in lista)
            {
                <tr>

                    <td>@d.IdDocumento</td>

                    <td>
                        <strong>@d.NumeroDocumento</strong>
                    </td>

                    <td>
                        <span class="badge bg-info text-dark">
                            @d.TipoDocumento
                        </span>
                    </td>

                    <td>@d.NombreCliente</td>

                    <td>@d.NombreNotario</td>

                    <td>@(d.FechaDocumento ?? "-")</td>

                    <td>@(d.Descripcion ?? "-")</td>

                    <td class="text-nowrap">

                        <button class="btn btn-sm btn-warning me-1"
                                @onclick="()=>Editar(d)">
                            ✏️
                        </button>

                        <button class="btn btn-sm btn-info me-1"
                                title="Descargar PDF"
                                @onclick="()=>DescargarPdf(d.IdDocumento, d.NumeroDocumento)">
                            📥
                        </button>

                        <button class="btn btn-sm btn-danger"
                                @onclick="()=>Eliminar(d.IdDocumento)">
                            🗑️
                        </button>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}

@code {

    List<NotariaAlmaguer.Web.Models.Documento>? lista;

    List<NotariaAlmaguer.Web.Models.Cliente>? clientes;

    List<NotariaAlmaguer.Web.Models.Notario>? notarios;

    NotariaAlmaguer.Web.Models.Documento form = new();

    byte[]? pdfBytes;

    bool mostrar;

    bool editando;

    string? msg;

    string? busqueda;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.Activa)
        {
            Nav.NavigateTo("/login");
            return;
        }

        lista = await DocSvc.GetAllAsync();

        clientes = await ClienteSvc.GetAllAsync();

        notarios = await NotarioSvc.GetAllAsync();
    }

    async Task Cargar()
    {
        lista = await DocSvc.GetAllAsync();
    }

    async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(busqueda))
        {
            await Cargar();
            return;
        }

        lista = await DocSvc.BuscarPorCodigoAsync(busqueda);

        if (!lista.Any())
        {
            msg = "⚠️ No se encontraron documentos.";
        }
    }

    async Task LimpiarBusqueda()
    {
        busqueda = null;
        await Cargar();
    }

    void Nuevo()
    {
        form = new();
        pdfBytes = null;
        editando = false;
        mostrar = true;
    }

    void Cancelar()
    {
        mostrar = false;
        form = new();
        pdfBytes = null;
    }

    void Editar(NotariaAlmaguer.Web.Models.Documento d)
    {
        form = new()
        {
            IdDocumento = d.IdDocumento,
            IdCliente = d.IdCliente,
            IdNotario = d.IdNotario,
            NumeroDocumento = d.NumeroDocumento,
            TipoDocumento = d.TipoDocumento,
            Descripcion = d.Descripcion
        };

        pdfBytes = null;

        editando = true;

        mostrar = true;
    }

    async Task CargarPdf(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.ContentType != "application/pdf")
        {
            msg = "⚠️ Solo PDFs.";
            return;
        }

        using var ms = new MemoryStream();

        await file.OpenReadStream(
            maxAllowedSize: 10 * 1024 * 1024)
            .CopyToAsync(ms);

        pdfBytes = ms.ToArray();
    }

    async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(form.NumeroDocumento)
            || string.IsNullOrWhiteSpace(form.TipoDocumento)
            || form.IdCliente == 0
            || form.IdNotario == 0)
        {
            msg = "⚠️ Complete todos los campos.";
            return;
        }

        if (editando)
        {
            await DocSvc.UpdateAsync(form);
        }
        else
        {
            await DocSvc.CreateAsync(form, pdfBytes);
        }

        msg = editando
            ? "✅ Documento actualizado."
            : "✅ Documento registrado.";

        mostrar = false;

        pdfBytes = null;

        await Cargar();
    }

    async Task DescargarPdf(int id, string nombre)
    {
        var pdf = await DocSvc.GetPdfAsync(id);

        if (pdf == null || pdf.Length == 0)
        {
            msg = "⚠️ No existe PDF.";
            return;
        }

        var b64 = Convert.ToBase64String(pdf);

        await JS.InvokeVoidAsync(
            "eval",
            $"const a=document.createElement('a');a.href='data:application/pdf;base64,{b64}';a.download='{nombre}.pdf';a.click()");
    }

    async Task Eliminar(int id)
    {
        await DocSvc.DeleteAsync(id);

        msg = "🗑️ Documento eliminado.";

        await Cargar();
    }

}