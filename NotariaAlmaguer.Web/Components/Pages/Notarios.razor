@page "/notarios"
@rendermode InteractiveServer
@inject NotarioService Svc
@inject Session Session
@inject NavigationManager Nav

<PageTitle>Notarios</PageTitle>
<h1>⚖️ Notarios</h1>

@if (msg != null)
{
    <div class="alert alert-info alert-dismissible fade show">@msg
        <button class="btn-close" @onclick="()=>msg=null"></button>
    </div>
}

<button class="btn btn-primary mb-3" @onclick="Nuevo">+ Nuevo Notario</button>

@if (mostrar)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-bold">@(editando?"Editar":"Nuevo") Notario</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre *</label>
                    <input class="form-control" @bind="form.Nombre" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">N° Licencia *</label>
                    <input class="form-control" @bind="form.NumeroLicencia" placeholder="NOT-001" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" @bind="form.Telefono" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <input class="form-control" @bind="form.Email" type="email" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Estado</label>
                    <select class="form-select" @bind="form.Activo">
                        <option value="1">Activo</option>
                        <option value="0">Inactivo</option>
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success me-2" @onclick="Guardar">💾 Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (lista == null) { <p><em>Cargando...</em></p> }
else if (!lista.Any()) { <p class="text-muted">No hay notarios registrados.</p> }
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr><th>#</th><th>Nombre</th><th>Licencia</th><th>Teléfono</th><th>Email</th><th>Estado</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var n in lista)
            {
                <tr>
                    <td>@n.IdNotario</td><td>@n.Nombre</td><td>@n.NumeroLicencia</td>
                    <td>@(n.Telefono??"-")</td><td>@(n.Email??"-")</td>
                    <td><span class="badge @(n.Activo==1?"bg-success":"bg-secondary")">@(n.Activo==1?"Activo":"Inactivo")</span></td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="()=>Editar(n)">✏️</button>
                        <button class="btn btn-sm btn-danger" @onclick="()=>Eliminar(n.IdNotario)">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<NotariaAlmaguer.Web.Models.Notario>? lista;
    NotariaAlmaguer.Web.Models.Notario form = new();
    bool mostrar, editando;
    string? msg;

    protected override async Task OnInitializedAsync() => await Cargar();
    async Task Cargar() => lista = await Svc.GetAllAsync();
    void Nuevo() { form = new(); editando=false; mostrar=true; }
    void Editar(NotariaAlmaguer.Web.Models.Notario n) { form = new(){IdNotario=n.IdNotario,Nombre=n.Nombre,NumeroLicencia=n.NumeroLicencia,Telefono=n.Telefono,Email=n.Email,Activo=n.Activo}; editando=true; mostrar=true; }
    void Cancelar() { mostrar=false; form=new(); }

    async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(form.Nombre)||string.IsNullOrWhiteSpace(form.NumeroLicencia))
        { msg="⚠️ Nombre y licencia son obligatorios."; return; }
        if (editando) await Svc.UpdateAsync(form);
        else await Svc.CreateAsync(form);
        msg = editando?"✅ Notario actualizado.":"✅ Notario creado.";
        mostrar=false; await Cargar();
    }
    async Task Eliminar(int id) { await Svc.DeleteAsync(id); msg="🗑️ Notario eliminado."; await Cargar(); }

        protected override void OnInitialized()
{
    if (!Session.Activa)
    {
        Nav.NavigateTo("/login");
    }
}
}
