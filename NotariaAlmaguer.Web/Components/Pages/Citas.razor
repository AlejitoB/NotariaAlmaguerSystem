@page "/citas"
@rendermode InteractiveServer
@inject CitaService CitaSvc
@inject ClienteService ClienteSvc
@inject NotarioService NotarioSvc
@inject Session Session
@inject NavigationManager Nav

<PageTitle>Citas</PageTitle>
<h1>📅 Agenda de Citas</h1>

@if (msg != null)
{
    <div class="alert alert-info alert-dismissible fade show">@msg
        <button class="btn-close" @onclick="()=>msg=null"></button>
    </div>
}

<button class="btn btn-primary mb-3" @onclick="Nuevo">+ Nueva Cita</button>

@if (mostrar)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-bold">@(editando?"Editar":"Nueva") Cita</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Cliente *</label>
                    <select class="form-select" @bind="form.IdCliente">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var c in clientes ?? [])
                        { <option value="@c.IdCliente">@c.Nombre (@c.Cedula)</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Notario *</label>
                    <select class="form-select" @bind="form.IdNotario">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var n in notarios ?? [])
                        { <option value="@n.IdNotario">@n.Nombre</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha y hora *</label>
                    <input class="form-control" type="datetime-local" @bind="fechaInput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select class="form-select" @bind="form.Estado">
                        <option value="pendiente">Pendiente</option>
                        <option value="confirmada">Confirmada</option>
                        <option value="completada">Completada</option>
                        <option value="cancelada">Cancelada</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Descripción</label>
                    <input class="form-control" @bind="form.Descripcion" placeholder="Motivo" />
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success me-2" @onclick="Guardar">💾 Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (lista == null) { <p><em>Cargando...</em></p> }
else if (!lista.Any()) { <p class="text-muted">No hay citas registradas.</p> }
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr><th>#</th><th>Cliente</th><th>Notario</th><th>Fecha</th><th>Estado</th><th>Descripción</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var c in lista)
            {
                <tr>
                    <td>@c.IdCita</td><td>@c.NombreCliente</td><td>@c.NombreNotario</td><td>@c.FechaCita</td>
                    <td><span class="badge @Badge(c.Estado)">@c.Estado</span></td>
                    <td>@(c.Descripcion??"-")</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="()=>Editar(c)">✏️</button>
                        <button class="btn btn-sm btn-danger" @onclick="()=>Eliminar(c.IdCita)">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<NotariaAlmaguer.Web.Models.Cita>? lista;
    List<NotariaAlmaguer.Web.Models.Cliente>? clientes;
    List<NotariaAlmaguer.Web.Models.Notario>? notarios;
    NotariaAlmaguer.Web.Models.Cita form = new();
    DateTime? fechaInput;
    bool mostrar, editando;
    string? msg;

    protected override async Task OnInitializedAsync()
    {
        lista = await CitaSvc.GetAllAsync();
        clientes = await ClienteSvc.GetAllAsync();
        notarios = await NotarioSvc.GetAllAsync();
    }

    async Task Cargar() => lista = await CitaSvc.GetAllAsync();
    void Nuevo() { form = new(){Estado="pendiente"}; fechaInput=null; editando=false; mostrar=true; }
    void Cancelar() { mostrar=false; form=new(); fechaInput=null; }
    void Editar(NotariaAlmaguer.Web.Models.Cita c)
    {
        form = new(){IdCita=c.IdCita,IdCliente=c.IdCliente,IdNotario=c.IdNotario,FechaCita=c.FechaCita,Estado=c.Estado,Descripcion=c.Descripcion};
        fechaInput = DateTime.TryParse(c.FechaCita, out var dt) ? dt : null;
        editando=true; mostrar=true;
    }

    async Task Guardar()
    {
        if (form.IdCliente==0||form.IdNotario==0||fechaInput==null)
        { msg="⚠️ Cliente, notario y fecha son obligatorios."; return; }
        form.FechaCita = fechaInput.Value.ToString("yyyy-MM-dd HH:mm:ss");
        if (editando) await CitaSvc.UpdateAsync(form);
        else await CitaSvc.CreateAsync(form);
        msg = editando?"✅ Cita actualizada.":"✅ Cita creada.";
        mostrar=false; await Cargar();
    }

    async Task Eliminar(int id) { await CitaSvc.DeleteAsync(id); msg="🗑️ Cita eliminada."; await Cargar(); }
   
    static string Badge(string e) => e switch { "confirmada"=>"bg-primary","completada"=>"bg-success","cancelada"=>"bg-danger",_=>"bg-warning text-dark" };

        protected override void OnInitialized()
{
    if (!Session.Activa)
    {
        Nav.NavigateTo("/login");
    }
}
}
